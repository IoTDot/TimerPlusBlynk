{
    "name": "TimerPlusBlynk DevContainer",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",  
    "features": {
      "ghcr.io/devcontainers/features/python:1": {
        "version": "3.11"
      }
    },
    "postCreateCommand": "pip install -U platformio && platformio update",
    "customizations": {
      "vscode": {
        "extensions": [
          "platformio.platformio-ide",
          "ms-vscode.cpptools"
        ]
      }
    },
    "forwardPorts": [8000],
    "remoteUser": "vscode"
  }
  